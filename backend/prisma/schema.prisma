generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationType {
  BUDGET_EXCEEDED
  BUDGET_CRITICAL
  BUDGET_WARNING
  GOAL_PROGRESS
  RECURRING
  INFO
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationCategory {
  BUDGET
  GOALS
  SUBSCRIPTIONS
  RECURRING
  UNUSUAL_SPENDING
  INSIGHTS
  SYSTEM
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PAID
  SKIPPED
}

enum OccurrenceStatus {
  GENERATED
  SKIPPED
  FAILED
}

enum DetectionType {
  LARGE_TRANSACTION
  CATEGORY_INCREASE
  UNUSUAL_MONTH
  REPEATED_INCREASE
}

enum DetectionStatus {
  NEW
  REVIEWED
  DISMISSED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  currency     String   @default("BDT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions      Transaction[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  goalContributions GoalContribution[]
  notifications     Notification[]
  unusualDetections UnusualDetection[]
  savedSimulations  SavedSimulation[]
  recurring         RecurringTransaction[]
  occurrences       RecurringOccurrence[]
  subscriptions     Subscription[]
  subscriptionPayments SubscriptionPayment[]
  notificationPreference NotificationPreference?
  reportSnapshots ReportSnapshot[]
  importBatches ImportBatch[]
  aiSetting AiSetting?
  aiUsage AiUsageLog[]
  aiDismissals AiDismissal[]
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  category    String
  description String
  notes       String?
  date        DateTime
  // Set only on transactions generated by a recurring schedule (see RecurringTransaction).
  recurringId    String?
  occurrenceDate DateTime?
  // Set only on expenses created for a subscription payment (Phase 13).
  subscriptionId String?
  // Set only on transactions created by a CSV import (Phase 16); lets one import be undone as a unit.
  importBatchId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  occurrences RecurringOccurrence[]
  subscription         Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionPayments SubscriptionPayment[]
  importBatch          ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // one transaction per schedule per scheduled date: makes generation idempotent at the database level
  @@unique([recurringId, occurrenceDate])
  @@unique([subscriptionId, occurrenceDate])
  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@index([importBatchId])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
}

model SavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  title        String
  targetAmount Decimal   @db.Decimal(12, 2)
  // savedAmount is always the sum of this goal's GoalContribution rows; it is only ever changed
  // together with a contribution (same DB transaction), never edited directly.
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  targetDate   DateTime?
  category     String?
  description  String?
  icon         String    @default("fa-piggy-bank")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

// Money moved INTO a savings goal. Deliberately NOT a Transaction: contributions are an
// allocation of income that is already recorded, so they never change income/expense totals.
model GoalContribution {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId, date])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  // Phase 14
  category    NotificationCategory @default(SYSTEM)
  dedupeKey   String?
  relatedType String?
  relatedId   String?
  link        String?
  readAt      DateTime?
  // e-mail delivery state: null = not attempted, SENDING, SENT (accepted by the mail server), FAILED, SKIPPED (hourly cap)
  emailStatus String?
  emailedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@index([userId, isRead, createdAt])
  @@index([userId, category])
}

model NotificationPreference {
  userId              String   @id
  budget              Boolean  @default(true)
  goals               Boolean  @default(true)
  subscriptions       Boolean  @default(true)
  recurring           Boolean  @default(true)
  unusualSpending     Boolean  @default(true)
  insights            Boolean  @default(true)
  system              Boolean  @default(true)
  renewalReminderDays Int      @default(3)
  // Phase 16 follow-up: optional e-mail copy of notifications (OFF by default; only works when the server has SMTP configured)
  emailEnabled        Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase 10: a finding from the unusual-spending rules. Never touches the underlying transactions.
model UnusualDetection {
  id              String          @id @default(uuid())
  userId          String
  type            DetectionType
  fingerprint     String
  category        String?
  transactionId   String?
  periodKey       String
  actualAmount    Decimal         @db.Decimal(12, 2)
  baselineAmount  Decimal         @db.Decimal(12, 2)
  difference      Decimal         @db.Decimal(12, 2)
  percentChange   Float?
  windowStart     DateTime
  windowEnd       DateTime
  explanation     String
  details         Json
  status          DetectionStatus @default(NEW)
  detectedAt      DateTime        @default(now())
  statusUpdatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status])
}

// Phase 11: a saved what-if scenario. Purely hypothetical: never linked to real transactions/budgets.
model SavedSimulation {
  id        String   @id @default(uuid())
  userId    String
  name      String
  inputs    Json
  baseline  Json
  results   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Phase 12: a schedule that generates real Transactions on its dates. All dates are UTC calendar days.
model RecurringTransaction {
  id              String              @id @default(uuid())
  userId          String
  title           String
  type            TransactionType
  amount          Decimal             @db.Decimal(12, 2)
  category        String
  notes           String?
  frequency       RecurrenceFrequency
  startDate       DateTime
  endDate         DateTime?
  nextOccurrence  DateTime?
  isActive        Boolean             @default(true)
  pausedAt        DateTime?
  lastGeneratedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  occurrences  RecurringOccurrence[]

  @@index([userId])
  @@index([isActive, nextOccurrence])
}

// One row per handled scheduled date (generated / skipped / failed). Unique per schedule+date.
model RecurringOccurrence {
  id            String           @id @default(uuid())
  recurringId   String
  userId        String
  scheduledDate DateTime
  status        OccurrenceStatus
  transactionId String?
  amount        Decimal          @db.Decimal(12, 2)
  error         String?
  attempts      Int              @default(0)
  generatedAt   DateTime?
  createdAt     DateTime         @default(now())

  recurring   RecurringTransaction @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([recurringId, scheduledDate])
  @@index([userId])
}

// Phase 13: a subscription SERVICE (lifecycle, renewal date, estimated cost). Separate from RecurringTransaction, which is a
// repeated ledger entry. Actual payments are SubscriptionPayment rows (+ optional linked Transaction).
model Subscription {
  id                 String                @id @default(uuid())
  userId             String
  name               String
  provider           String?
  category           String
  amount             Decimal               @db.Decimal(12, 2)
  currency           String                @default("BDT")
  frequency          SubscriptionFrequency
  customIntervalDays Int?
  startDate          DateTime
  nextRenewalDate    DateTime?
  billingAnchor      DateTime
  endDate            DateTime?
  paymentMethod      String?
  notes              String?
  status             SubscriptionStatus    @default(ACTIVE)
  autoRecord         Boolean               @default(false)
  reminderDays       Int?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]
  transactions Transaction[]

  @@index([userId])
  @@index([status, nextRenewalDate])
}

model SubscriptionPayment {
  id             String        @id @default(uuid())
  subscriptionId String
  userId         String
  dueDate        DateTime
  amount         Decimal       @db.Decimal(12, 2)
  currency       String
  status         PaymentStatus @default(PAID)
  source         String        @default("MANUAL")
  transactionId  String?
  paidAt         DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, dueDate])
  @@index([userId])
}

// Phase 15: a saved copy of a report as it looked at one moment. Reports themselves are DYNAMIC (recalculated from the
// transactions every time); a snapshot is a frozen record, clearly labelled as such. fingerprint = hash of the period and the
// figures, so saving an unchanged report twice returns the existing snapshot instead of creating a duplicate.
model ReportSnapshot {
  id          String   @id @default(uuid())
  userId      String
  title       String
  period      String
  startDate   DateTime
  endDate     DateTime
  fingerprint String
  payload     Json
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, generatedAt])
}

// Phase 16: history of imports. Rows are written only AFTER the user confirms (a preview stores nothing). Transactions created by a
// CSV import carry importBatchId so one import can be undone cleanly. Failed imports are logged with a generic message only.
enum ImportKind {
  TRANSACTIONS_CSV
  BACKUP_RESTORE
}

enum ImportStatus {
  COMPLETED
  FAILED
  UNDONE
}

model ImportBatch {
  id               String       @id @default(uuid())
  userId           String
  kind             ImportKind
  status           ImportStatus
  fileName         String?
  fileHash         String?
  mode             String?
  totalRows        Int          @default(0)
  importedRows     Int          @default(0)
  duplicateSkipped Int          @default(0)
  invalidRows      Int          @default(0)
  summary          Json?
  errorMessage     String?
  createdAt        DateTime     @default(now())
  undoneAt         DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
}

// Phase 17: AI assistant. AiSetting = per-user switches (external AI is OPT-IN, default off). AiUsageLog records what happened WITHOUT the
// question text or any financial figures (tool name, source, status, latency only). AiDismissal remembers dismissed recommendations by key
// (the key includes the month, so the same recommendation does not come back that month).
model AiSetting {
  userId     String   @id
  enabled    Boolean  @default(true)
  externalAi Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiUsageLog {
  id        String   @id @default(uuid())
  userId    String
  tool      String?
  source    String
  status    String
  latencyMs Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiDismissal {
  id        String   @id @default(uuid())
  userId    String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
