generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationType {
  BUDGET_EXCEEDED
  BUDGET_CRITICAL
  BUDGET_WARNING
  GOAL_PROGRESS
  INFO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  currency     String   @default("BDT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions      Transaction[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  goalContributions GoalContribution[]
  notifications     Notification[]
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  category    String
  description String
  notes       String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
}

model SavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  title        String
  targetAmount Decimal   @db.Decimal(12, 2)
  // savedAmount is always the sum of this goal's GoalContribution rows; it is only ever changed
  // together with a contribution (same DB transaction), never edited directly.
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  targetDate   DateTime?
  category     String?
  description  String?
  icon         String    @default("fa-piggy-bank")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

// Money moved INTO a savings goal. Deliberately NOT a Transaction: contributions are an
// allocation of income that is already recorded, so they never change income/expense totals.
model GoalContribution {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId, date])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
