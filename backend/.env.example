DATABASE_URL="postgresql://username:password@localhost:5432/fintrack?schema=public"
JWT_SECRET="replace_with_a_long_random_secret_string"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://127.0.0.1:5500"
NODE_ENV="development"

# Optional e-mail copy of notifications (off unless BOTH SMTP_HOST and EMAIL_FROM are set; users opt in individually)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="FinTrack <noreply@example.com>"
# APP_URL=http://localhost:5500

# Optional external AI model for the assistant (off unless set; users also opt in). The assistant works fully without it.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_ENABLED=true
